# Server-only Postgres connection. Use the event database, with SSL verification enabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
# Generate a different random value for each secret. Never commit .env.local.
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
# For local PostgreSQL only; omit this for hosted databases.
# DATABASE_SSL=disable
